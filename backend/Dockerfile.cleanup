# Dedicated one-shot image for the account-deletion cleanup worker.
# Deploy as a separate Railway service rooted at /backend and attach a cron schedule.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.txt
COPY . .
CMD ["python", "scripts/run_account_cleanup.py"]
